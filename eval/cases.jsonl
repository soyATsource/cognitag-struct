# 評価セット。1 行 1 ケース。expect は最後のターンに対する期待値。
#
# known_gap: true は「今は落ちるのが正しい」ケース。将来の辞書強化で
# 解消することを期待しているもの。点数には含めない。
#
# 期待値は「現状の出力」ではなく「こうあるべき」で書くこと。
# 現状を写すと、何を直すべきかが評価セットから消える。

# --- モダリティ: 挨拶 -------------------------------------------------------
{"id": "greet_01", "turns": ["おはよう"], "expect": {"modality": "GREETING", "policy": "greeting", "no_question": true}}
{"id": "greet_02", "turns": ["こんにちは"], "expect": {"modality": "GREETING", "policy": "greeting"}}
{"id": "greet_03", "turns": ["こんばんは"], "expect": {"modality": "GREETING", "policy": "greeting"}}
{"id": "greet_04", "turns": ["ありがとう"], "expect": {"policy": "thanks", "text_none": "取れなかった"}}

# --- モダリティ: 依頼 -------------------------------------------------------
{"id": "req_01", "turns": ["手伝ってください"], "expect": {"modality": "REQUEST", "policy": "request"}}
{"id": "req_02", "turns": ["教えてください"], "expect": {"modality": "REQUEST", "policy": "no_knowledge"}, "note": "知識を差し出す依頼は受領しない。受けると実行できない約束になる"}
{"id": "req_03", "turns": ["確認してもらえますか"], "expect": {"modality": "REQUEST", "policy": "request"}}
{"id": "req_04", "turns": ["お願いします"], "expect": {"modality": "REQUEST"}}
{"id": "req_05", "turns": ["資料を送ってください"], "expect": {"modality": "REQUEST", "no_question": true}, "note": "依頼では空きスロットを問い詰めない"}
{"id": "req_06", "turns": ["直してくれる"], "expect": {"modality": "REQUEST"}}

